{
  "title": "日本人が一生でスマホを見る時間は？",
  "segments": [
    {
      "text": "人生の7年半、スマホに消えるとしたら？",
      "scene": "phone"
    },
    {
      "text": "1日3時間見ると仮定してみよう。",
      "scene": "clock"
    },
    {
      "text": "1年で1095時間。",
      "scene": "calendar"
    },
    {
      "text": "60年間なら、6万5700時間！",
      "scene": "phone"
    },
    {
      "text": "なんと約2738日。7年半に相当！",
      "scene": "clock"
    },
    {
      "text": "これは仮定の計算。あなたは1日何時間？",
      "scene": "phone"
    }
  ]
}

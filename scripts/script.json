{
  "title": "日本人は一生で何日間通勤する？",
  "segments": [
    {
      "text": "日本人は一生で何日間、通勤していると思う？",
      "scene": "train"
    },
    {
      "text": "片道30分なら、往復で1時間。",
      "scene": "road"
    },
    {
      "text": "年間240日働くと、240時間。",
      "scene": "clock"
    },
    {
      "text": "40年間で、9600時間。",
      "scene": "office"
    },
    {
      "text": "なんと400日分！ほぼ1年以上を通勤に使う計算。",
      "scene": "clock"
    },
    {
      "text": "あなたの通勤時間は何分？コメントで教えて！",
      "scene": "train"
    }
  ]
}
